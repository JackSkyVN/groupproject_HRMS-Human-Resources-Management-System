function renderPerformance() {
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    const isHR = userRole === "HR Staff" || (appData.currentUser && appData.currentUser.email.startsWith("ha1972816"));
    const isTeamView = appData.performanceViewType === 'team';

    return `
        <div class="page-header">
            <h1>${isTeamView ? 'Team Performance' : 'My Performance'}</h1>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">${isTeamView ? 'Team Review History' : 'My Review History'}</h2>
                ${isHR && isTeamView ? `
                <button class="btn btn-primary" onclick="openAddReviewModal()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add New Review
                </button>
                ` : ''}
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            ${isTeamView ? '<th>Employee</th>' : ''}
                            <th>Period</th>
                            <th>Rating</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${appData.performanceReviews.length === 0 ? '<tr><td colspan="5" style="text-align:center; padding: 20px;">No reviews found.</td></tr>' : ''}
                        ${appData.performanceReviews.map(review => `
                            <tr>
                                ${isTeamView ? `<td>${review.employee_name || 'N/A'}</td>` : ''}
                                <td>${review.period}</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div class="progress-bar" style="width: 80px;">
                                            <div class="progress-fill" style="width: ${((review.final_rating || review.manager_rating || review.self_rating || 0) / 5) * 100}%; background-color: ${getRatingColor(review.final_rating || review.manager_rating || review.self_rating || 0)};"></div>
                                        </div>
                                        <span>${review.final_rating || review.manager_rating || review.self_rating || 'N/A'}/5</span>
                                    </div>
                                </td>
                                <td><span class="badge badge-${getReviewStatusClass(review.status)}">${(review.status === 'Finalized' || review.status === 'Completed') ? 'COMPLETED' : review.status}</span></td>
                                <td>
                                    <button class="btn btn-small btn-secondary" onclick="viewReviewDetails(${review.id})">Details</button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            </div>
        </div>
    `;
}

