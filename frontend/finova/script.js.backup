    employees: [],
    leaveRequests: [],
    attendance: [],
    performance: [],
    performanceKPIs: [],
    performanceReviews: [],
    performanceViewType: 'my', // 'my' or 'team'
    performanceReviewCycle: 'Q4 2024',
    salaries: [],
    announcements: [],
    departments: [],
    positions: [],
    attendanceDate: new Date().toISOString().split('T')[0],
    attendanceDeptId: '',
    attendancePosId: '',
    attendanceDeptName: '',
    attendancePosName: '',
    includeAbsent: false,
    showOnlyAbsent: false,
    attendanceFilterType: 'daily', // 'daily', 'monthly', or 'range'
    attendanceMonth: new Date().toISOString().slice(0, 7), // YYYY-MM
    attendanceStartDate: new Date().toISOString().split('T')[0],
    attendanceEndDate: new Date().toISOString().split('T')[0],
    attendanceStats: [],
    salaryRequests: []
};




let currentPage = 'dashboard';
let nextId = {
    employees: 6,
    leaveRequests: 5,
    attendance: 6,
    performance: 5
};

// Pagination State
let currentEmployeePage = 1;
const itemsPerPage = 20;

document.addEventListener('DOMContentLoaded', async () => {
    setupNavigation();
    setupHeaderListeners(); // Restore Header Interactability

    // Lấy data từ backend
    await fetchDashboardData();

    renderPage('dashboard');
});


async function fetchDashboardData() {
    const token = localStorage.getItem('token');

    if (!token) {
        window.location.href = '../../Login screen/index.html';
        return;
    }

    const headers = {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json',
        'Cache-Control': 'no-cache',
        'Pragma': 'no-cache'
    };

    const fetchOptions = {
        headers: headers,
        cache: 'no-store'
    };

    const timestamp = new Date().getTime();

    try {
        console.log("Fetching Current User...");
        const meRes = await fetch(`${API_BASE_URL}/api/v1/auth/me`, fetchOptions);
        if (meRes.ok) {
            appData.currentUser = await meRes.json();

            // Should also fetch Employee Profile to get "Full Name"
            const profileRes = await fetch(`${API_BASE_URL}/api/v1/employees/me`, fetchOptions);
            if (profileRes.ok) {
                const profile = await profileRes.json();
                appData.currentUser.full_name = profile.full_name;
                appData.currentUser.name = profile.full_name;
                appData.currentUser.profile = profile;
            } else {
                appData.currentUser.full_name = appData.currentUser.email; // Fallback
                appData.currentUser.name = appData.currentUser.email; // Fallback
            }

            // Critical Update: Ensure roles are up-to-date in localStorage
            if (appData.currentUser.roles) {
                localStorage.setItem('roles', JSON.stringify(appData.currentUser.roles));
            }

            // RE-CHECK visibility now that we have user profile
            updateSidebarVisibility();
        }

        console.log("Fetching Employees...");
        // Lấy danh sách Nhân viên
        const empResponse = await fetch(`${API_BASE_URL}/api/v1/employees?_t=${timestamp}`, fetchOptions);
        if (empResponse.status === 401) {
            console.warn("Session potentially expired or server restarted.");
            // We removed the aggressive alert/redirect to keep the user from being "văng ra"
            // If they are truly logged out, the next critical action will naturally fail or they can manually refresh.
            return;
        }
        if (empResponse.ok) {
            const employees = await empResponse.json();
            // Map API response to Frontend format
            appData.employees = employees.map(e => ({
                id: e.id,
                name: e.full_name || e.email,
                username: e.email ? e.email.split('@')[0] : "",
                position: e.position_name || 'N/A',
                department: e.department_name || 'N/A',
                email: e.email,
                phone: e.phone || 'N/A',
                joinDate: '2024-01-01',
                status: 'Active',
                salary: e.salary || 0,
                important_employee: e.important_employee
            }));

            appData.employees.sort((a, b) => {
                const deptCompare = a.department.localeCompare(b.department);
                if (deptCompare !== 0) return deptCompare;
                return a.position.localeCompare(b.position);
            });

            // Extract unique departments and positions for filters
            const depts = new Map();
            const pos = new Map();
            employees.forEach(e => {
                // Ensure we don't add "N/A" or empty values to the filter lists
                if (e.department_id && e.department !== 'N/A') depts.set(e.department_id, e.department);
                if (e.position_id && e.position !== 'N/A') pos.set(e.position_id, e.position);
            });
            appData.departments = Array.from(depts, ([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));
            appData.positions = Array.from(pos, ([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));

            // Fallback: If profile fetch failed or is missing, find myself in the list
            if (appData.currentUser && (!appData.currentUser.profile || !appData.currentUser.profile.id)) {
                const myProfile = appData.employees.find(e => e.email === appData.currentUser.email);
                if (myProfile) {
                    console.log("[Auth Fallback] Profiling matched from list:", myProfile.id);
                    appData.currentUser.profile = myProfile;
                }
            }

            appData.salaries = [];
            appData.employees.forEach(emp => {
                const baseSalary = emp.salary;
                const bonus = Math.floor(baseSalary * 0.1);
                const benefits = Math.floor(baseSalary * 0.15);
                const tax = Math.floor((baseSalary + bonus) * 0.2);
                appData.salaries.push({
                    id: emp.id,
                    employeeId: emp.id,
                    employeeName: emp.name,
                    baseSalary: baseSalary,
                    bonus: bonus,
                    benefits: benefits,
                    tax: tax,
                    netSalary: baseSalary + bonus + benefits - tax,
                    month: new Date().toISOString().slice(0, 7),
                    status: 'Pending'
                });
            });
        }

        console.log("Fetching Attendance...");
        // Lấy dữ liệu Điểm danh
        const attResponse = await fetch(`${API_BASE_URL}/api/v1/attendance?_t=${timestamp}`, fetchOptions);
        if (attResponse.ok) {
            const resData = await attResponse.json();
            const attendance = resData.items || [];
            // API response mapping
            appData.attendance = attendance.map(a => {
                let hoursStr = '-';
                if (a.check_in_time && a.check_out_time) {
                    try {
                        const [h1, m1] = a.check_in_time.split(':').map(Number);
                        const [h2, m2] = a.check_out_time.split(':').map(Number);
                        const totalMinutes = (h2 * 60 + m2) - (h1 * 60 + m1);
                        if (totalMinutes > 0) {
                            const hh = Math.floor(totalMinutes / 60);
                            const mm = totalMinutes % 60;
                            hoursStr = `${hh}h ${mm}m`;
                        }
                    } catch (e) {
                        console.error("Error calculating hours", e);
                    }
                }
                return {
                    id: a.id,
                    employeeId: a.employee_id,
                    employeeName: a.employee_name || 'Individual',
                    department: a.department || 'N/A',
                    position: a.position || 'N/A',
                    date: a.date,
                    checkIn: a.check_in_time,
                    checkOut: a.check_out_time || '-',
                    hours: hoursStr,
                    status: a.status
                };
            });
        }

    } catch (error) {
        console.error("Error fetching dashboard data:", error);
        showToast("Error", "danger");
    }

    try {
        console.log("Fetching Additional Data...");

        // Fetch Leaves
        try {
            const leaveRes = await fetch(`${API_BASE_URL}/api/v1/leaves?include_deleted=true&_t=${timestamp}`, fetchOptions);
            if (leaveRes.ok) {
                const leaves = await leaveRes.json();
                appData.leaveRequests = leaves.map(l => ({
                    id: l.id,
                    employeeId: l.employee_id,
                    employeeName: l.employee_name,
                    type: l.leave_type,
                    startDate: l.start_date,
                    endDate: l.end_date,
                    days: l.days,
                    reason: l.reason,
                    status: l.approval_status,
                    approver_name: l.approver_name,
                    isDeleted: l.is_deleted,
                    created_at: l.created_at
                }));
            }
        } catch (e) { console.error("Error fetching leaves:", e); }

        // Fetch Payroll
        try {
            const payRes = await fetch(`${API_BASE_URL}/api/v1/payroll?_t=${timestamp}`, fetchOptions);
            if (payRes.ok) {
                const payrolls = await payRes.json();
                payrolls.forEach(p => {
                    const local = appData.salaries.find(s => s.employeeId === p.employee_id);
                    if (local) {
                        local.id = p.id;
                        local.status = p.status;
                        local.netSalary = p.net_salary;
                        local.tax = p.tax;
                        local.bonus = p.bonus;
                        local.benefits = p.benefits;
                        local.baseSalary = p.base_salary;
                        local.month = p.month;
                    } else {
                        appData.salaries.push({
                            id: p.id,
                            employeeId: p.employee_id,
                            employeeName: p.employee_name,
                            baseSalary: p.base_salary,
                            bonus: p.bonus,
                            benefits: p.benefits,
                            tax: p.tax,
                            netSalary: p.net_salary,
                            month: p.month,
                            status: p.status
                        });
                    }
                });
            }
        } catch (e) { console.error("Error fetching payroll:", e); }

        // Fetch Announcements
        try {
            const annRes = await fetch(`${API_BASE_URL}/api/v1/announcements?_t=${timestamp}`, fetchOptions);
            if (annRes.ok) {
                appData.announcements = await annRes.json();
                updateNotificationBadge();
            } else {
                console.warn("Announcement fetch failed with status:", annRes.status);
                // alert(`Debug: Announcement fetch failed: ${annRes.status}`);
            }
        } catch (e) { console.error("Error fetching announcements:", e); showToast("Error fetching announcements", "danger"); }

        // Lấy dữ liệu attendance stats cho ngày hiện tại
        await fetchAttendanceStats();

        // Lấy dữ liệu Đề xuất lương (Salary Requests)
        await fetchSalaryRequests();

        // Update sidebar visibility based on newly fetched user roles
        updateSidebarVisibility();

    } catch (error) {
        console.error("Error fetching additional data:", error);
    }
}


window.switchPage = async function (page) {
    currentPage = page;

    // Update active states
    document.querySelectorAll('.nav-item').forEach(btn => {
        const btnPage = btn.getAttribute('data-page');
        if (btnPage === page ||
            (page.startsWith('attendance-') && btnPage === 'attendance') ||
            (page.startsWith('performance-') && btnPage === 'performance') ||
            (page.startsWith('salary-') && btnPage === 'salary')) {
            btn.parentElement.classList.add('active');
            btn.classList.add('active');
        } else {
            btn.parentElement.classList.remove('active');
            btn.classList.remove('active');
        }
    });

    document.querySelectorAll('.submenu-item').forEach(btn => {
        if (btn.getAttribute('data-page') === page) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });

    // Handle data pre-fetching
    if (page === 'attendance' || page === 'attendance-team') {
        appData.attendanceEmployeeId = null; // Clear personal filter
        await Promise.all([fetchAttendanceHistory(), fetchAttendanceStats()]);
    } else if (page === 'attendance-my') {
        appData.attendanceEmployeeId = appData.currentUser?.profile?.id || null;
        await Promise.all([fetchAttendanceHistory(), fetchAttendanceStats()]);
    } else if (page === 'performance-team') {
        appData.performanceViewType = 'team';
        await Promise.all([fetchPerformanceData(), fetchPerformanceReviews()]);
    } else if (page === 'performance-my') {
        appData.performanceViewType = 'my';
        await Promise.all([fetchPerformanceData(), fetchPerformanceReviews()]);
    } else if (page === 'salary-my' || page === 'salary-team') {
        await fetchSalaryRequests();
    }

    renderPage(page);
};

