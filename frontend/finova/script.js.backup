    <div class="submenu">
        <button class="submenu-item" data-page="attendance-my" onclick="switchPage('attendance-my')">
            <span class="nav-text">My Attendance</span>
        </button>
        <button class="submenu-item" data-page="attendance-team" onclick="switchPage('attendance-team')">
            <span class="nav-text">Employees Attended</span>
        </button>
    </div>
`;

const PERFORMANCE_SUBMENU_HTML = `
    <div class="submenu">
        <button class="submenu-item" data-page="performance-my" onclick="switchPage('performance-my')">
            <span class="nav-text">My Performance</span>
        </button>
        <button class="submenu-item" data-page="performance-team" onclick="switchPage('performance-team')">
            <span class="nav-text">Team Performance</span>
        </button>
    </div>
`;

const SALARY_SUBMENU_HTML = `
    <div class="submenu">
        <button class="submenu-item" data-page="salary-my" onclick="switchPage('salary-my')">
            <span class="nav-text">My Salary</span>
        </button>
        <button class="submenu-item" data-page="salary-team" onclick="switchPage('salary-team')">
            <span class="nav-text">Employee Salary</span>
        </button>
    </div>
`;

function updateSidebarVisibility() {
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    const isHRDirector = userEmail.startsWith("ha1972816");
    const isHRStaff = userRole === "HR Staff";
    const isAdmin = userEmail.startsWith("to1979714");

    // Admin (to1979714) is EXPLICITLY excluded from managing Attendance
    const canManageAttendance = isHRDirector || isHRStaff;

    const attendanceNavGroup = document.getElementById('attendance-nav-group');
    if (attendanceNavGroup) {
        let submenu = attendanceNavGroup.querySelector('.submenu');

        if (canManageAttendance) {
            attendanceNavGroup.style.display = 'flex';
            // If submenu is missing (removed by previous non-HR login), RE-INJECT it
            if (!submenu) {
                attendanceNavGroup.insertAdjacentHTML('beforeend', ATTENDANCE_SUBMENU_HTML);
                submenu = attendanceNavGroup.querySelector('.submenu');
            }
            if (submenu) submenu.style.display = 'flex';
        } else {
            // Non-HR users see a simple link, NO submenu
            // REMOVE the submenu from DOM to prevent CSS hover issues and fix login memory
            if (submenu) submenu.remove();
            attendanceNavGroup.style.display = 'flex';
        }
    }

    const performanceNavGroup = document.getElementById('performance-nav-group');
    if (performanceNavGroup) {
        let submenu = performanceNavGroup.querySelector('.submenu');
        const canManagePerformance = isHRDirector || isHRStaff;

        if (canManagePerformance) {
            performanceNavGroup.style.display = 'flex';
            if (!submenu) {
                performanceNavGroup.insertAdjacentHTML('beforeend', PERFORMANCE_SUBMENU_HTML);
                submenu = performanceNavGroup.querySelector('.submenu');
            }
            if (submenu) submenu.style.display = 'flex';
        } else {
            if (submenu) submenu.remove();
            performanceNavGroup.style.display = 'flex';
        }
    }

    // 5. Salary: Strict Separation
    const salaryNavGroup = document.getElementById('salary-nav-group');
    if (salaryNavGroup) {
        let submenu = salaryNavGroup.querySelector('.submenu');
        // Logic: ONLY HR Director or HR Staff (or Admin if specified) get "Employee Salary"
        // Everyone else gets "My Salary" ONLY.
        const canManageSalary = isHRDirector || isHRStaff; // Admin sees My Salary only, no submenu

        // Always show the container
        salaryNavGroup.style.display = 'flex';

        if (canManageSalary) {
            // 1. HR/Admin: Show Submenu
            if (!submenu) {
                salaryNavGroup.insertAdjacentHTML('beforeend', SALARY_SUBMENU_HTML);
                submenu = salaryNavGroup.querySelector('.submenu');
            }
            if (submenu) submenu.style.display = 'flex';
        } else {
            // 2. Regular User: DIRECT ACCESS to My Salary. NO SUBMENU.
            if (submenu) submenu.remove();

            // Note: The click handler for the parent '.nav-item' must handle the routing.
            // In setupNavigation, switching 'salary' -> 'salary-my' handles this.
        }
    }
}

function setupNavigation() {
    const navItems = document.querySelectorAll('.nav-item');

    // Initial visibility check (might be empty if user data not yet fetched)
    updateSidebarVisibility();

    navItems.forEach(btn => {
        btn.addEventListener('click', () => {
            const page = btn.getAttribute('data-page');

            // DYNAMIC check for role at click time
            const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
            const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
            const isHRDirector = userEmail.startsWith("ha1972816");
            const isHRStaff = userRole === "HR Staff";
            // Admin is EXPLICITLY excluded from managing Attendance
            const canManageAttendance = isHRDirector || isHRStaff;

            if (page === 'attendance') {
                // For Attendance, default to 'my' or 'team' based on role
                switchPage(canManageAttendance ? 'attendance-team' : 'attendance-my');
            } else if (page === 'performance') {
                const isHRDirector = userEmail.startsWith("ha1972816");
                const isHRStaff = userRole === "HR Staff";
                switchPage((isHRDirector || isHRStaff) ? 'performance-team' : 'performance-my');
            } else if (page === 'salary') {
                const isHRDirector = userEmail.startsWith("ha1972816");
                const isHRStaff = userRole === "HR Staff";
                // If they have the submenu rights, default to Team, else My
                const canManage = isHRDirector || isHRStaff;
                switchPage(canManage ? 'salary-team' : 'salary-my');
            } else {
                switchPage(page);
            }
        });
    });
}

function setupHeaderListeners() {
    // 1. Notification Bell
    const notifBtn = document.getElementById('notification-bell');
    if (notifBtn) {
        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleNotifications();
        });
    }

    // 2. Mark All Read
    const markReadBtn = document.getElementById('mark-all-read-btn');
    if (markReadBtn) {
        markReadBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            markAllRead();
        });
    }

    // 3. Profile Button
    const profileBtn = document.getElementById('profile-btn');
    if (profileBtn) {
        profileBtn.addEventListener('click', () => {
            if (appData.currentUser && appData.currentUser.profile) {
                viewEmployee(appData.currentUser.profile.id);
            } else {
                showToast("Profile not loaded yet", "warning");
            }
        });
    }

    // 4. Logout Button
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', () => {
            logout();
        });
    }
}

function renderPage(page) {
    const contentArea = document.getElementById('content-area');

    switch (page) {
        case 'dashboard':
            contentArea.innerHTML = renderDashboard();
            break;
        case 'employees':
            contentArea.innerHTML = renderEmployees();
            setupEmployeesListeners();
            break;
        case 'leave':
            contentArea.innerHTML = renderLeave();
            setupLeaveListeners();
            break;
        case 'attendance':
        case 'attendance-team':
            contentArea.innerHTML = renderAttendance('team');
            setupAttendanceListeners();
            break;
        case 'attendance-my':
            contentArea.innerHTML = renderAttendance('my');
            setupAttendanceListeners();
            break;
        case 'performance-my':
            contentArea.innerHTML = renderPerformance();
            setupPerformanceListeners();
            break;
        case 'performance-team':
            contentArea.innerHTML = renderPerformance();
            setupPerformanceListeners();
            break;
        case 'salary':
        case 'salary-team':
            contentArea.innerHTML = renderSalary('team');
            setupSalaryListeners();
            break;
        case 'salary-my':
            contentArea.innerHTML = renderSalary('my');
            setupSalaryListeners();
            break;
        case 'announcements':
            contentArea.innerHTML = renderAnnouncements();
            setupAnnouncementListeners();
            break;
    }
}

// Dashboard
function renderDashboard() {
    const totalEmployees = appData.employees.length;
    const activeEmployees = appData.employees.filter(e => e.status === 'Active').length;
    const pendingLeaves = appData.leaveRequests.filter(l => (l.status.includes('Pending') || l.status === 'Waiting') && !l.isDeleted).length;
    const todayStr = new Date().toISOString().split('T')[0];
    const coreCouncilUsernames = ["truong1979746", "tran1975778", "pham1973439", "le1984949"];
    const trackedEmployees = appData.employees.filter(e => !coreCouncilUsernames.includes(e.username) && e.status === 'Active');
    const totalTracked = trackedEmployees.length;

    const presentTodayCount = new Set(appData.attendance
        .filter(a => a.date === todayStr && a.status !== 'Absent')
        .filter(a => {
            const emp = appData.employees.find(e => e.id === a.employeeId);
            return emp && !coreCouncilUsernames.includes(emp.username);
        })
        .map(a => a.employeeId)
    ).size;
    const absentToday = totalTracked - presentTodayCount;

    return `
        <div class="page-header">
            <h1>Dashboard</h1>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Total Employees</span>
                    <div class="stat-icon blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                </div>
                <div class="stat-value">${totalEmployees}</div>
                <div class="stat-description">${activeEmployees} active employees</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Present Today</span>
                    <div class="stat-icon green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="stat-value" style="display: flex; align-items: baseline; gap: 8px;">
                    <span style="color: #10b981;">${presentTodayCount}</span>
                    <span style="font-size: 1rem; color: #94a3b8; font-weight: 400;">/</span>
                    <span style="color: #ef4444; font-size: 1.5rem;">${absentToday}</span>
                </div>
                <div class="stat-description">${presentTodayCount} present, ${absentToday} absent</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Pending Leaves</span>
                    <div class="stat-icon yellow">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                </div>
                <div class="stat-value">${appData.leaveRequests.filter(l => (l.status.includes('Pending') || l.status === 'Waiting') && !l.isDeleted).length}</div>
                <div class="stat-description">Awaiting approval</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Avg Performance</span>
                    <div class="stat-icon purple">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    </div>
                </div>
                <div class="stat-value">4.5</div>
                <div class="stat-description">Based on recent reviews</div>
            </div>
        </div>

        <div class="card" style="margin-top: 20px;">
            <div class="card-header">
                <h2 class="card-title">My Attendance</h2>
            </div>
            <div class="attendance-actions" style="padding: 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
                <div id="attendance-status-display" style="flex: 1;">
                    ${(() => {
            const d = new Date();
            const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            const myEmpId = appData.currentUser && appData.currentUser.profile ? appData.currentUser.profile.id : null;

            // Debug logs
            console.log("[Attendance Debug] Today:", today, "MyEmpID:", myEmpId);
            console.log("[Attendance Debug] All Attendance:", appData.attendance);

            const myRecords = appData.attendance.filter(a => {
                const isMatch = String(a.date) === today && Number(a.employeeId) === Number(myEmpId);
                return isMatch;
            });

            if (myRecords.length === 0) return '<div style="font-size: 1.2rem; font-weight: 500; color: #64748b;">Not Checked In Today</div>';

            const last = myRecords[0];
            const isLate = last.status.includes('Late');
            const isEarly = last.status.includes('Early Leave');
            const isViolation = isLate || isEarly;

            return `
                            <div style="display: flex; gap: 15px;">
                                <div style="padding: 10px 15px; background: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0;">
                                    <span style="font-size: 0.8rem; color: #166534; display: block; margin-bottom: 2px;">CHECK IN</span>
                                    <span style="font-size: 1.1rem; font-weight: 600; color: #15803d;">${last.checkIn}</span>
                                </div>
                                ${last.checkOut && last.checkOut !== '-' ? `
                                <div style="padding: 10px 15px; background: #eef2ff; border-radius: 8px; border: 1px solid #c7d2fe;">
                                    <span style="font-size: 0.8rem; color: #3730a3; display: block; margin-bottom: 2px;">CHECK OUT</span>
                                    <span style="font-size: 1.1rem; font-weight: 600; color: #4338ca;">${last.checkOut}</span>
                                </div>` : ''}
                                <div style="display: flex; align-items: center; margin-left: 10px;">
                                    <span class="badge badge-${isViolation ? 'danger' : last.status === 'OT' ? 'info' : 'success'}" 
                                          title="${last.lateMinutes ? `Late: ${last.lateMinutes}m` : ''} ${last.earlyLeaveMinutes ? `Early: ${last.earlyLeaveMinutes}m` : ''}"
                                          style="font-size: 0.9rem; padding: 6px 12px;">
                                        ${last.status}
                                    </span>
                                </div>
                            </div>
                        `;
        })()}
                </div>
                <div style="display: flex; gap: 12px;">
                    <button id="main-checkin-btn" onclick="handleCheckIn()" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981, #059669); border: none; padding: 12px 24px; font-weight: 600;">Check In</button>
                    <button id="main-checkout-btn" onclick="handleCheckOut()" class="btn btn-secondary" style="padding: 12px 24px; font-weight: 600;">Check Out</button>
                </div>
            </div>
            <div style="padding: 0 24px 20px 24px; border-top: 0px solid #f1f5f9; display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.85rem; color: #94a3b8;">
                <div style="display: flex; align-items: center; gap: 5px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></div> Shift: 08:30</div>
                <div style="display: flex; align-items: center; gap: 5px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #6366f1;"></div> End: 17:30</div>
                <div style="display: flex; align-items: center; gap: 5px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></div> OT: 18:00 - 21:00</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Recent Activity</h2>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Activity</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${(() => {
            let activities = [];
            appData.leaveRequests.forEach(leave => {
                // 1. The Request itself
                activities.push({
                    employee: leave.employeeName,
                    activity: `Leave Request - ${leave.type}`,
                    date: leave.startDate,
                    status: leave.status,
                    timestamp: new Date(leave.created_at || leave.startDate).getTime()
                });

                // 2. The Approval/Rejection action (if processed)
                if (leave.approver_name && (leave.status === 'Approved' || leave.status === 'Rejected')) {
                    activities.push({
                        employee: leave.approver_name,
                        activity: `${leave.status} leave for ${leave.employeeName}`,
                        date: leave.startDate,
                        status: leave.status,
                        timestamp: new Date(leave.created_at || leave.startDate).getTime() + 1 // Slightly after request
                    });
                }
            });

            // 3. Attendance Events
            appData.attendance.forEach(att => {
                const emp = appData.employees.find(e => e.id === att.employeeId);
                const name = emp ? emp.name : (att.employeeName || 'Individual');

                activities.push({
                    employee: name,
                    activity: `Check In - ${att.status}`,
                    date: att.date,
                    status: att.status,
                    timestamp: new Date(`${att.date}T${att.checkIn}`).getTime()
                });

                if (att.checkOut && att.checkOut !== '-') {
                    activities.push({
                        employee: name,
                        activity: `Check Out`,
                        date: att.date,
                        status: att.status,
                        timestamp: new Date(`${att.date}T${att.checkOut}`).getTime()
                    });
                }
            });

            // 4. Data Hygiene: Filter out invalid dates and old records
            const threeMonthsAgo = Date.now() - (90 * 24 * 60 * 60 * 1000);
            activities = activities.filter(act => !isNaN(act.timestamp) && act.timestamp >= threeMonthsAgo);

            // Sort by timestamp descending
            activities.sort((a, b) => b.timestamp - a.timestamp);

            const pool = getManagedEmployeePool();
            const managedNames = pool.map(e => e.name);
            const isHrDirector = (appData.currentUser && appData.currentUser.email === 'ha1972816@finova.vn');

            // If HR Director, only show activities for their managed pool
            if (isHrDirector) {
                activities = activities.filter(act => managedNames.includes(act.employee));
            }

            return activities.slice(0, 10).map(act => {
                const displayStatus = act.status === 'Pending Director' ? 'Waiting' : act.status;
                const badgeClass = act.status === 'Approved' ? 'success' :
                    (act.status.includes('Pending') || act.status === 'Waiting') ? 'warning' : 'danger';

                return `
                                <tr>
                                    <td>${act.employee}</td>
                                    <td>${act.activity}</td>
                                    <td>${act.date}</td>
                                    <td><span class="badge badge-${badgeClass}">${displayStatus}</span></td>
                                </tr>
                            `;
            }).join('');
        })()}
                    </tbody>
                </table>
            </div>
        </div>
    `;
}

// Employees
function renderEmployees() {
    return `
        <div class="page-header">
            <h1>Employees</h1>
        </div>

        <div class="card">
            <div class="card-header" style="justify-content: flex-end;">
                ${renderAddEmployeeButton()}
            </div>
            
            <div class="search-bar">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" class="search-input" id="employee-search" placeholder="Search employees...">
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="employees-table-body">
                        ${renderEmployeesRows()}
                    </tbody>
                </table>
            </div>

            <div class="pagination-controls" style="display: flex; justify-content: flex-end; align-items: center; gap: 5px; margin-top: 20px;">
                ${renderPaginationButtons()}
            </div>
        </div>
    `;
}

function renderPaginationButtons() {
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const searchInput = document.getElementById('employee-search');
    const searchTerm = searchInput ? searchInput.value : '';

    const filtered = appData.employees.filter(emp =>
        emp.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.position.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.department.toLowerCase().includes(searchTerm.toLowerCase())
    );

    if (filtered.length === 0) return '';

    const totalPages = Math.ceil(filtered.length / itemsPerPage);
    if (totalPages <= 1) return '';

    let buttonsHtml = '';

    for (let i = 1; i <= totalPages; i++) {
        const activeClass = i === currentEmployeePage ? 'btn-primary' : 'btn-outline';
        buttonsHtml += `<button class="btn btn-small ${activeClass}" onclick="goToPage(${i})">${i}</button>`;
    }

    if (currentEmployeePage < totalPages) {
        buttonsHtml += `<button class="btn btn-small btn-outline" onclick="goToPage(${currentEmployeePage + 1})">»</button>`;
    }

    return buttonsHtml;
}

function goToPage(page) {
    currentEmployeePage = page;
    const searchInput = document.getElementById('employee-search');
    const searchTerm = searchInput ? searchInput.value : '';
    document.getElementById('employees-table-body').innerHTML = renderEmployeesRows(searchTerm);
    // Re-render buttons
    const container = document.querySelector('.pagination-controls');
    if (container) container.innerHTML = renderPaginationButtons();
}

function renderAddEmployeeButton() {
    // Try appData first, then localStorage
    const userRoles = (appData.currentUser && appData.currentUser.roles)
        ? appData.currentUser.roles
        : JSON.parse(localStorage.getItem('roles') || '[]');

    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const currentUsername = userEmail.split('@')[0];
    const isHrDirector = currentUsername === 'ha1972816';
    const isHrStaff = userRoles.includes('hr') && !isHrDirector;
    const isAdmin = userRoles.includes('admin') || currentUsername === 'to1979714';

    if (isAdmin || isHrDirector || isHrStaff) {
        return `<button class="btn btn-primary" onclick="openAddEmployeeModal()">+ Add Employee</button>`;
    }
    return '';
}

function renderEmployeesRows(searchTerm = '') {
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const isAdmin = roles.includes('admin');

    const pool = getManagedEmployeePool();
    const isActuallyManageable = (empId) => pool.some(m => m.id === empId);

    const filtered = appData.employees.filter(emp =>
        emp.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.position.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.department.toLowerCase().includes(searchTerm.toLowerCase())
    );

    if (filtered.length === 0) {
        setTimeout(() => updatePaginationControls(0), 0);
        return '<tr><td colspan="6" style="text-align: center; padding: 40px;">No employees found</td></tr>';
    }

    const totalPages = Math.ceil(filtered.length / itemsPerPage);
    if (currentEmployeePage > totalPages) currentEmployeePage = totalPages;
    if (currentEmployeePage < 1) currentEmployeePage = 1;

    const start = (currentEmployeePage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const paginated = filtered.slice(start, end);

    setTimeout(() => updatePaginationControls(filtered.length), 0);

    return paginated.map(emp => `
        <tr>
            <td>${emp.name}</td>
            <td>${emp.position}</td>
            <td>${emp.department}</td>
            <td>${emp.email}</td>
            <td><span class="badge badge-${emp.status === 'Active' ? 'success' : 'warning'}">${emp.status}</span></td>
            <td>
                <div class="action-buttons">
                    <button class="btn btn-small btn-secondary" onclick="viewEmployee(${emp.id})">View</button>
                    ${(() => {
            const currentUserEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
            const currentUsername = currentUserEmail.split('@')[0];

            const isHrDirector = (roles.includes('hr') && roles.includes('director')) || currentUsername === 'ha1972816';
            const isHrStaff = roles.includes('hr') && !isHrDirector;
            const isAdmin = roles.includes('admin') || currentUsername === 'to1979714';

            // IMPORTANT: Management rights remain restricted to the managed pool
            const manageable = isActuallyManageable(emp.id);

            // Fixed 5 Protected Accounts
            const protectedUsernames = ["to1979714", "truong1979746", "tran1975778", "pham1973439", "le1984949"];

            let canDelete = false;

            if (!manageable) {
                canDelete = false;
            } else if (protectedUsernames.includes(emp.username) || emp.username === currentUsername || currentUsername === 'to1979714') {
                canDelete = false;
            } else {
                if (isAdmin) {
                    // Normal Admin (if any other exists) can delete
                    canDelete = (currentUsername !== 'to1979714');
                } else if (isHrDirector) {
                    // HR Director can delete anyone else (non-protected)
                    canDelete = true;
                } else if (isHrStaff) {
                    // HR Staff manages ONLY Regular staff (non-leaders)
                    // AND cannot touch Council (already blocked), HR Dept, or Admin
                    canDelete = (!emp.important_employee &&
                        emp.department !== "HR Department" &&
                        emp.username !== 'to1979714');
                }
            }

            return canDelete ? `<button class="btn btn-small btn-danger" onclick="deleteEmployee(${emp.id})">Delete</button>` : '';
        })()}
                </div>
            </td>
        </tr>
    `).join('');
}

function setupEmployeesListeners() {
    const searchInput = document.getElementById('employee-search');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const tbody = document.getElementById('employees-table-body');
            tbody.innerHTML = renderEmployeesRows(e.target.value);
            tbody.innerHTML = renderEmployeesRows(e.target.value);
        });
    }
}

function prevPage() {
    if (currentEmployeePage > 1) {
        currentEmployeePage--;
        const searchInput = document.getElementById('employee-search');
        const searchTerm = searchInput ? searchInput.value : '';
        document.getElementById('employees-table-body').innerHTML = renderEmployeesRows(searchTerm);
    }
}

function nextPage() {
    const searchInput = document.getElementById('employee-search');
    const searchTerm = searchInput ? searchInput.value : '';

    const filtered = appData.employees.filter(emp =>
        emp.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.position.toLowerCase().includes(searchTerm.toLowerCase()) ||
        emp.department.toLowerCase().includes(searchTerm.toLowerCase())
    );
    const totalPages = Math.ceil(filtered.length / itemsPerPage);

    if (currentEmployeePage < totalPages) {
        currentEmployeePage++;
        document.getElementById('employees-table-body').innerHTML = renderEmployeesRows(searchTerm);
    }
}

function updatePaginationControls(totalItems) {
    const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const indicator = document.getElementById('page-indicator');

    if (btnPrev && btnNext && indicator) {
        btnPrev.disabled = currentEmployeePage === 1;
        btnNext.disabled = currentEmployeePage === totalPages;
        indicator.textContent = `Page ${currentEmployeePage} of ${totalPages}`;
    }
}

