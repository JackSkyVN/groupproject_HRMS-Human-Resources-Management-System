// Logout
function logout() {
    if (confirm("Are you sure you want to log out?")) {
        localStorage.removeItem('token');
        localStorage.removeItem('roles');
        window.location.href = '../../Login screen/index.html';
    }
}
// Notification Logic
function toggleNotifications() {
    const dropdown = document.getElementById('notification-dropdown');
    dropdown.classList.toggle('show');
    if (dropdown.classList.contains('show')) {
        renderNotificationsDropdown();
    }
}

function markAllRead() {
    const dropdown = document.getElementById('notification-dropdown');
    dropdown.classList.remove('show');
}

async function handleDeleteNotification(id, type, event) {
    if (event) event.stopPropagation();

    if (type === 'notification') {
        const token = localStorage.getItem('token');
        try {
            const res = await fetch(`${API_BASE_URL} /api/v1 / notifications / ${id} `, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token} ` }
            });
            if (res.ok) {
                // Remove from appData locally
                appData.announcements = appData.announcements.filter(a => !(a.id === id && a.type === 'notification'));
                renderNotificationsDropdown();
                updateNotificationBadge();
            } else {
                console.error("Failed to delete notification");
            }
        } catch (e) {
            console.error("Error deleting notification:", e);
        }
    } else if (type === 'announcement') {
        // Dismiss announcement for this user only
        const hiddenAnns = JSON.parse(localStorage.getItem('hiddenAnnouncements') || '[]');
        if (!hiddenAnns.includes(id)) {
            hiddenAnns.push(id);
            localStorage.setItem('hiddenAnnouncements', JSON.stringify(hiddenAnns));
        }
        renderNotificationsDropdown();
        updateNotificationBadge();
        if (currentPage === 'announcements') renderAnnouncementsPage();
    }
}

function renderAnnouncementsPage() {
    const area = document.getElementById('content-area');
    if (area) area.innerHTML = renderAnnouncements();
}

// Close dropdown when clicking outside
document.addEventListener('click', (e) => {
    const container = document.querySelector('.notification-container');
    const dropdown = document.getElementById('notification-dropdown');
    if (container && !container.contains(e.target) && dropdown && dropdown.classList.contains('show')) {
        dropdown.classList.remove('show');
    }
});

function renderNotificationsDropdown() {
    const list = document.getElementById('notification-list');
    const announcements = appData.announcements || [];
    const hiddenAnns = JSON.parse(localStorage.getItem('hiddenAnnouncements') || '[]');

    // Filter out announcements already dismissed by this user
    const visibleAnns = announcements.filter(ann => {
        if (ann.type === 'announcement' && hiddenAnns.includes(ann.id)) return false;
        return true;
    });

    if (visibleAnns.length === 0) {
        list.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b;">No notifications</div>';
        return;
    }

    // Sort by date desc
    const sorted = [...visibleAnns].sort((a, b) => new Date(b.created_at || 0) - new Date(a.created_at || 0));

    list.innerHTML = sorted.map(ann => `
    < div class="notification-item" style = "position: relative; padding-right: 40px;" >
                <div class="notification-title">${ann.title}</div>
                <div class="notification-content">${ann.content.substring(0, 60)}${ann.content.length > 60 ? '...' : ''}</div>
                <div class="notification-date">${new Date(ann.created_at || Date.now()).toLocaleDateString()}</div>
                <button 
                    onclick="handleDeleteNotification(${ann.id}, '${ann.type}', event)" 
                    style="position: absolute; top: 10px; right: 10px; background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 4px;"
                    title="Delete"
                >
                    &times;
                </button>
            </div >
    `).join('');
}

function updateNotificationBadge() {
    const badge = document.getElementById('notification-badge');
    const announcements = appData.announcements || [];
    const hiddenAnns = JSON.parse(localStorage.getItem('hiddenAnnouncements') || '[]');

    const visibleCount = announcements.filter(ann => {
        if (ann.type === 'announcement' && hiddenAnns.includes(ann.id)) return false;
        return true;
    }).length;

    if (visibleCount > 0 && badge) {
        badge.style.display = 'flex';
        badge.textContent = visibleCount;
    } else if (badge) {
        badge.style.display = 'none';
    }
}
// Attendance Handlers
async function handleCheckIn() {
    try {
        const token = localStorage.getItem('token');
        const res = await fetch(`${API_BASE_URL} /api/v1 / attendance / check -in -manual`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token} `,
                'Content-Type': 'application/json'
            }
        });
        const data = await res.json();
        if (res.ok) {
            showToast(`Check - In Successful! Status: ${data.status} at ${data.time} `);
            await fetchDashboardData();
            renderPage('dashboard');
        } else {
            showToast(data.detail || "Check-In Failed", "error");
        }
    } catch (err) {
        console.error("Check-in error:", err);
        showToast(`Error during check -in: ${err.message || 'Network error'} `, "error");
    }
}

async function handleCheckOut() {
    try {
        const token = localStorage.getItem('token');
        const res = await fetch(`${API_BASE_URL} /api/v1 / attendance / check - out - manual`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token} `,
                'Content-Type': 'application/json'
            }
        });
        const data = await res.json();
        if (res.ok) {
            showToast(`Check - Out Successful! Status: ${data.status} at ${data.time} `);
            await fetchDashboardData();
            renderPage('dashboard');
        } else {
            showToast(data.detail || "Check-Out Failed", "error");
        }
    } catch (err) {
        console.error("Check-out error:", err);
        showToast(`Error during check - out: ${err.message || 'Network error'} `, "error");
    }
}

function showToast(message, type = "success") {
    let container = document.getElementById('toast-container');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.innerHTML = `<div class="toast-content">${message}</div>`;

    container.appendChild(toast);

    // Auto remove
    setTimeout(() => {
        toast.classList.add('fade-out');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

window.logout = function () {
    localStorage.removeItem('token');
    localStorage.removeItem('roles');
    window.location.href = '../../Login screen/index.html';
};

// Global Exports for UI interaction
window.exportAttendance = exportAttendance;
window.exportPayroll = exportPayroll;
window.handleSmartFilter = handleSmartFilter;
window.handleAttendanceParamChange = handleAttendanceParamChange;
window.toggleShowOnlyAbsent = toggleShowOnlyAbsent;
window.viewSalaryDetails = viewSalaryDetails;
window.processSalary = processSalary;
window.openSalaryProposalModal = openSalaryProposalModal;
window.openComplaintModal = openComplaintModal;
window.handleCheckIn = handleCheckIn;
window.handleCheckOut = handleCheckOut;
