/**
 * Unified helper to get the pool of manageable employees based on role hierarchy.
 */
function getManagedEmployeePool() {
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    // Safe access to user_id
    const currentUserId = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.user_id : null;

    const isHRDirector = userEmail.startsWith("ha1972816");
    const isHRStaff = userRole === "HR Staff";
    const isAdmin = userEmail.startsWith("to1979714");

    const leadershipKeywords = [
        "Director", "Chief", "Head", "Chairman", "Leader",
        "Giám đốc", "Trưởng", "Phó", "Chủ tịch", "General Director",
        "Chánh", "Chỉ huy", "Lãnh đạo", "Acting"
    ];

    if (isAdmin) {
        // Admin can view everyone
        return appData.employees;
    }

    if (isHRDirector) {
        // 1. Explicitly Exclude Members' Council
        // 2. Include employees created by Me (HR Director)
        // 3. Include employees created by My Staff (HR Staff)
        // 4. Fallback for Seeded Data (created_by_id is null): Use previous logic (Leadership + HR Dept - IT) but STILL exclude Council.

        // Find HR Staff User IDs for lineage check
        const hrStaffUserIds = appData.employees
            .filter(e => e.position === "HR Staff" || (e.department === "HR Department" && e.position !== "HR Director"))
            .map(e => e.user_id)
            .filter(id => id != null);

        return appData.employees.filter(e => {
            // Absolute Exclusion
            if (e.department === "Members' Council") return false;

            // Absolute Inclusion: Admin
            if (e.email === "to1979714@finova.vn") return true;

            // Ownership Logic: Created by Me or My Staff
            if (e.created_by_id) {
                if (e.created_by_id === currentUserId) return true;
                if (hrStaffUserIds.includes(e.created_by_id)) return true;
                // If created by someone else (e.g. Admin or IT), do not manage? 
                // User said "what I need is those...". Implies exclusivity.
                // But let's be safe and allow fallback if it matches strict criteria? 
                // No, "created_by_id" presence implies it's a managed user. If not mine, not my business.
                // However, let's Stick to the "Fallback" ONLY if created_by_id is null/missing.
                return false;
            }

            // Fallback for Seeded/Legacy Data (No Creator)
            const isLeadership = leadershipKeywords.some(k => (e.position || "").toLowerCase().includes(k.toLowerCase()));
            const isHR = e.department === "HR Department" || e.position === "HR Staff";
            const isIT = e.department === "IT Department";

            // Previous Scope: Leadership OR HR Dept, exclude IT.
            // And now we already excluded Council above.
            return (isLeadership || isHR) && !isIT;
        });
    }

    if (isHRStaff) {
        // HR Staff manages: ALL except Members' Council AND Leadership
        return appData.employees.filter(e => {
            const isCouncil = e.department === "Members' Council";
            if (isCouncil) return false;

            // Allow HR Staff to see themselves
            if (String(e.id) === String(appData.currentUser?.profile?.id)) return true;

            const isLeadership = leadershipKeywords.some(k => (e.position || "").toLowerCase().includes(k.toLowerCase()));
            return !isLeadership;
        });
    }

    // Default: Show all employees for viewing (everyone can see everyone)
    return appData.employees;
}

// Helper to render position options
function renderPositionOptions(includePlaceholder = true, forModal = false) {
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    const isHRDirector = userEmail.startsWith("ha1972816");
    const isHRStaff = userRole === "HR Staff";
    const isAdmin = userEmail.startsWith("to1979714");

    let positions = [];

    if (forModal) {
        // Use full Master Lists for adding/editing
        if (isHRDirector) {
            positions = LEADERSHIP_POSITIONS;
        } else if (isHRStaff) {
            positions = GENERAL_POSITIONS;
        } else if (isAdmin) {
            positions = ["HR Director"];
        }
    } else {
        // Dynamic Filter for Attendance (only show who exists in pool)
        const pool = getManagedEmployeePool();
        positions = [...new Set(pool.map(e => e.position).filter(p => p && p !== 'N/A'))];
    }

    positions.sort();
    const placeholder = includePlaceholder ? `<option value="">Select Position</option>` : '';
    return placeholder + positions.map(p => `<option value="${p}">${p}</option>`).join('');
}

// Helper to render department options
function renderDepartmentOptions(includePlaceholder = true, forModal = false) {
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    const isHRDirector = userEmail.startsWith("ha1972816");
    const isHRStaff = userRole === "HR Staff";
    const isAdmin = userEmail.startsWith("to1979714");

    let depts = [];

    if (forModal) {
        if (isHRDirector) {
            depts = LEADERSHIP_DEPTS;
        } else if (isHRStaff) {
            depts = GENERAL_DEPTS;
        } else if (isAdmin) {
            depts = ["HR Department"];
        }
    } else {
        const pool = getManagedEmployeePool();
        depts = [...new Set(pool.map(e => e.department).filter(d => d && d !== 'N/A'))];
    }

    depts.sort();
    const placeholder = includePlaceholder ? `<option value="">Select Department</option>` : '';
    return placeholder + depts.map(d => `<option value="${d}">${d}</option>`).join('');
}

// Handle Fixed Salary calculation based on Position & Dept
window.handleSalaryChange = function () {
    const posSelect = document.getElementById('pos-select');
    const deptSelect = document.getElementById('dept-select');
    const salaryInput = document.getElementById('salary-input');
    const salaryHelp = document.getElementById('salary-help');

    if (!posSelect || !deptSelect || !salaryInput) return;

    const pos = posSelect.value || "";
    const dept = deptSelect.value || "";

    if (!pos || !dept) {
        salaryInput.value = '';
        return;
    }

    // Fixed Salary Logic (Mirroring apply_salary_grading.py)
    const p = pos.toLowerCase();
    const d = dept.toLowerCase();
    let salary = 900; // Default

    if (p.includes("chairman")) salary = 5500;
    else if (p.includes("general director") && !p.includes("deputy")) salary = 5000;
    else if (p.includes("council member") && !p.includes("general director")) salary = 4500;
    else if (p.includes("deputy general director - head of department")) salary = 4200;
    else if (p.includes("deputy general director")) salary = 4500;
    else if (p.includes("chief accountant")) salary = 4200;
    else if ((p.includes("director") && !p.includes("general") && !p.includes("deputy")) || p.includes("head of internal audit")) salary = 3500;
    else if ((p.includes("deputy director") && !p.includes("general")) || p.includes("acting deputy director") || (p.includes("chief of office") && !p.includes("deputy"))) salary = 3000;
    else if (p.includes("head of division") && !p.includes("deputy")) salary = 2500;
    else if (p.includes("deputy head of division") || p.includes("deputy chief of office")) salary = 2200;
    else if (p.includes("senior specialist") || d.includes("it department") || p.includes("software") || p.includes("engineer")) salary = 1500;
    else if (d.includes("finance") || d.includes("accounting")) salary = 1200;
    else if (d.includes("hr department") || d.includes("legal") || d.includes("tender")) salary = 1100;
    else if (p.includes("driver") || p.includes("staff")) salary = 1000;

    salaryInput.value = salary;
    salaryInput.readOnly = true;
    salaryInput.style.backgroundColor = '#f1f5f9';
    if (salaryHelp) salaryHelp.innerText = `Fixed Salary based on position: $${salary}.`;
};

// Legacy alias to prevent errors
window.handleDeptChange = window.handleSalaryChange;

async function handleAddEmployee(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const token = localStorage.getItem('token');

    const rawPassword = formData.get('password');
    const finalPassword = rawPassword ? rawPassword : "123456";

    // Construct email from Username + Domain
    const usernameInput = formData.get('username_input');
    const domainInput = formData.get('domain_input');
    const fullEmail = `${usernameInput}@${domainInput}`;

    // STRICT HIERARCHICAL VALIDATION
    const currentUserEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const currentUsername = currentUserEmail.split('@')[0];
    const targetDept = formData.get('department');

    // 1. ADMIN (to1979714)
    if (currentUsername === "to1979714") {
        if (usernameInput !== "ha1972816") {
            showToast("Not Allowed", "warning");
            return;
        }
        // ADMIN (to1979714): Can only add to specific departments (as per renderDepartmentOptions)
        // This check is redundant if renderDepartmentOptions is correctly limiting the dropdown,
        // but good for backend validation.
        const allowedDeptsForAdmin = [
            "Finance - Accounting Department",
            "HR Department",
            "Members' Council",
            "Board of General Directors"
        ];
        if (!allowedDeptsForAdmin.includes(targetDept)) {
            showToast("Error", "danger");
            return;
        }
    }
    // 2. HR DIRECTOR (ha1972816)
    else if (currentUsername === "ha1972816") {
        // Allow all departments - backend will handle strict validation
        // (This allows "Office", "Tender", etc. which were previously blocked)
    }
    // 3. HR STAFF (Check by Role - implicitly handled by backend for regular staff, but ideally prevent editing Boss)
    // For "Add", it's fine. Logic usually means they can't add to "HR Department" to avoid privilege escalation.
    else {
        // Regular HR Staff checks
        const targetDept = formData.get('department');
        const restrictedDepts = ["Members' Council", "Board of General Directors", "HR Department"];
        if (restrictedDepts.includes(targetDept)) {
            showToast("Not Allowed", "warning");
            return;
        }
    }

    const payload = {
        email: fullEmail,
        password: finalPassword,
        full_name: formData.get('name'),
        position_id: null,
        position_name: formData.get('position'),
        department_id: null,
        department_name: formData.get('department'),
        date_of_birth: formData.get('joinDate'), // Using join date as DOB for now or null
        phone: formData.get('phone'),
        salary: parseFloat(formData.get('salary') || 0),
        important_employee: formData.get('important_employee') === 'on'
    };

    // Map department names to IDs (Simple logic for now, ideally fetch from API)
    const deptMap = {
        "Engineering": 1, "Product": 2, "Design": 3,
        "HR": 4, "Marketing": 5, "Sales": 6, "Administration Department": 1,
        "Members' Council": 1 // Map to Admin Dept ID 1 for now
    };
    payload.password = finalPassword;
    payload.department_id = deptMap[formData.get('department')] || 1;

    try {
        const response = await fetch(`${API_BASE_URL}/api/v1/employees`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (response.status === 401) {
            showToast("Session Expired. Please login again.", "warning");
            localStorage.removeItem('token');
            window.location.href = '../../Login screen/index.html';
            return;
        }

        if (response.ok) {
            showToast(`Employee added successfully!`);
            closeModal();
            await fetchDashboardData(); // Reload data from server
            renderPage('employees');
        } else {
            // ERROR HANDLING
            const err = await response.json();

            if (response.status === 403) {
                showToast("Not Allowed", "warning");
            } else {
                showToast("Error: " + (err.detail || "Unknown Error"), "danger");
            }
        }
    } catch (error) {
        console.error("Add error:", error);
        showToast("Error", "danger");
    }
}

function viewEmployee(id) {
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const isAdmin = roles.includes('admin');

    const employee = appData.employees.find(e => e.id === id);
    if (!employee) return;

    const modal = `
        <div class="modal-overlay" onclick="closeModal(event)">
            <div class="modal" onclick="event.stopPropagation()">
                <div class="modal-header">
                    <h2 class="modal-title">Employee Details</h2>
                    <button class="modal-close" onclick="closeModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="salary-details">
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Name:</span>
                            <span class="salary-detail-value">${employee.name}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Position:</span>
                            <span class="salary-detail-value">${employee.position}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Department:</span>
                            <span class="salary-detail-value">${employee.department}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Email:</span>
                            <span class="salary-detail-value">${employee.email}</span>
                        </div>

                        ${(() => {
            const userRoles = (appData.currentUser && appData.currentUser.roles) ? appData.currentUser.roles : JSON.parse(localStorage.getItem('roles') || '[]');
            const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
            const currentUname = userEmail.split('@')[0];
            const isSelf = employee.id === (appData.currentUser && appData.currentUser.profile ? appData.currentUser.profile.id : null);

            // Strictest Privacy (v4): ONLY Self can see Phone and Salary in VIEW mode
            if (isSelf) {
                return `
                                <div class="salary-detail-row">
                                    <span class="salary-detail-label">Phone:</span>
                                    <span class="salary-detail-value">${employee.phone || (appData.currentUser.profile ? appData.currentUser.profile.phone : 'N/A')}</span>
                                </div>
                                <div class="salary-detail-row">
                                    <span class="salary-detail-label">Salary:</span>
                                    <span class="salary-detail-value">$${employee.salary || 0}</span>
                                </div>
                                <div class="salary-detail-row" style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px;">
                                    <span class="salary-detail-label">Password:</span>
                                    <button onclick="openChangePasswordModal()" class="btn btn-primary btn-small">Change Password</button>
                                </div>
                            `;
            }
            return "";
        })()}

                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Status:</span>
                            <span class="salary-detail-value"><span class="badge badge-${employee.status === 'Active' ? 'success' : 'warning'}">${employee.status}</span></span>
                        </div>
                         ${(() => {
            const currentUserEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
            const currentUsername = currentUserEmail.split('@')[0];

            const isHrDirector = (roles.includes('hr') && roles.includes('director')) || currentUsername === 'ha1972816';
            const isHrStaff = roles.includes('hr') && !isHrDirector;
            const isAdmin = roles.includes('admin') || currentUsername === 'to1979714';

            let canManage = false;
            const managedPool = getManagedEmployeePool();
            const manageable = managedPool.some(m => m.id === employee.id);

            if (!manageable) {
                canManage = false;
            } else if (currentUsername === 'to1979714') {
                canManage = false;
            } else if (isAdmin) {
                // Other admins (if any)
                canManage = (employee.username === 'ha1972816');
            } else if (isHrDirector) {
                // HR Director manages everyone except Council
                canManage = (employee.department !== "Members' Council" && employee.username !== currentUsername);
            } else if (isHrStaff) {
                // HR Staff manages regular employees only, except Council, HR, or Bosses
                canManage = (!employee.important_employee &&
                    employee.department !== "Members' Council" &&
                    employee.department !== "HR Department" &&
                    employee.username !== 'to1979714' &&
                    employee.username !== 'ha1972816');
            }

            if (canManage) {
                return `
                                <div class="salary-detail-row" style="margin-top:20px; border-top:1px solid #eee; padding-top:10px;">
                                    <span class="salary-detail-label">Actions:</span>
                                    <div class="action-buttons">
                                        <button class="btn btn-primary" onclick="openEditEmployeeModal(${employee.id})">Edit Employee</button>
                                        <button class="btn btn-danger" onclick="deleteEmployee(${employee.id})">Delete Employee</button>
                                    </div>
                                </div>`;
            }
            return '';
        })()}
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Close</button>
                </div>
            </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modal;
}

async function deleteEmployee(id) {
    if (confirm('Are you sure you want to PERMANENTLY delete this employee?')) {
        const token = localStorage.getItem('token');
        try {
            const response = await fetch(`${API_BASE_URL}/api/v1/employees/${id}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (response.status === 401) {
                showToast("Session Expired. Please login again.", "warning");
                localStorage.removeItem('token');
                window.location.href = '../../Login screen/index.html';
                return;
            }

            if (response.ok) {
                showToast('Employee deleted successfully!');
                // Close modal if open
                closeModal();
                // Refetch all data from backend to ensure consistency
                await fetchDashboardData();
                // Re-render the employees page to show updated data
                renderPage('employees');
                setupEmployeesListeners();
            } else {
                const err = await response.json();
                showToast("Failed to delete: " + (err.detail || "Unknown error"), "danger");
            }
        } catch (error) {
            console.error("Delete error:", error);
            showToast("Network error while deleting", "danger");
        }
    }
}


async function openMyProfile() {
