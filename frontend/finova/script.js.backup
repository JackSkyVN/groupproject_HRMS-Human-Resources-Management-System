async function handleAddReview(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const data = Object.fromEntries(formData.entries());

    const token = localStorage.getItem('token');
    try {
        const res = await fetch(`${API_BASE_URL}/api/v1/performance/reviews`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
                ...data,
                employee_id: parseInt(data.employee_id),
                manager_rating: parseFloat(data.manager_rating),
                status: 'Completed'
            })
        });

        if (res.ok) {
            closeModal();
            // Small delay to ensure DB commit is reflected and DOM is stable
            setTimeout(async () => {
                await fetchPerformanceReviews();
                renderPage(appData.performanceViewType === 'team' ? 'performance-team' : 'performance-my');
            }, 100);
        } else {
            const err = await res.json();
            showToast(`Error: ${err.detail || 'Failed to create review'}`, "danger");
        }
    } catch (e) {
        console.error(e);
        showToast("Server error", "danger");
    }
}

async function setPerformanceView(view) {
    appData.performanceViewType = view;
    await fetchPerformanceReviews();
    renderPage('performance');
}

function getReviewStatusClass(status) {
    switch (status) {
        case 'Completed':
        case 'Finalized':
            return 'success';
        case 'Pending Manager': return 'warning';
        case 'Self-Assessment': return 'info';
        case 'Draft': return 'secondary';
        default: return 'primary';
    }
}

function getRatingColor(rating) {
    if (rating >= 4.5) return '#10b981'; // Green
    if (rating >= 4) return '#3b82f6'; // Blue
    if (rating >= 3) return '#f59e0b'; // Amber
    return '#ef4444'; // Red
}

