                    <div class="salary-details">
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Employee:</span>
                            <span class="salary-detail-value">${perf.employeeName}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Review Period:</span>
                            <span class="salary-detail-value">${perf.period}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Rating:</span>
                            <span class="salary-detail-value">${perf.rating}/5</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Goals:</span>
                            <span class="salary-detail-value">${perf.goals}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Achievements:</span>
                            <span class="salary-detail-value">${perf.achievements}</span>
                        </div>
                        <div class="salary-detail-row">
                            <span class="salary-detail-label">Feedback:</span>
                            <span class="salary-detail-value">${perf.feedback}</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Close</button>
                </div>
            </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modal;
}

// Exchange Rate (1:1 since Input is now USD)
const EXCHANGE_RATE = 1;

function formatUSD(val) {
    return '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// Salary Management
// Salary Management
function renderSalary(viewType = 'team') {
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const isManager = roles.includes('admin') || roles.includes('hr');

    // 1. My Salary
    const currentUserEmail = appData.currentUser ? appData.currentUser.email : '';
    const myEmp = appData.employees.find(e => e.email === currentUserEmail);
    const myEmpId = myEmp ? myEmp.id : -1;
    const mySalary = appData.salaries.find(s => s.employeeId === myEmpId);

    // 2. Manage Employees (For HR/Admin)
    // Filter out MY salary from the management list to avoid self-approval logic confusion here
    // HR is not allowed to edit own salary.
    let manageSalaries = [];
    if (isManager) {
        const managedPool = getManagedEmployeePool();
        const managedIds = managedPool.map(e => e.id);
        manageSalaries = appData.salaries.filter(s => managedIds.includes(s.employeeId) && s.employeeId !== myEmpId);
    }

    let headerTitle = "Salary Management";
    let headerDesc = ""; // Description removed as per user request

    if (viewType === 'my') {
        headerTitle = "My Salary";
    } else {
        headerTitle = "Employee Salary";
    }

    const mySalarySection = `
        <!-- Section: My Salary -->
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <h2 class="card-title">My Salary Details</h2>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Base Salary</th>
                            <th>Bonus</th>
                            <th>Benefits</th>
                            <th>Tax</th>
                            <th>Net Salary</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${mySalary ? `
                            <tr>
                                <td>${mySalary.employeeName}</td>
                                <td>${formatUSD(mySalary.baseSalary)}</td>
                                <td>${formatUSD(mySalary.bonus)}</td>
                                <td>${formatUSD(mySalary.benefits)}</td>
                                <td>${formatUSD(mySalary.tax)}</td>
                                <td>${formatUSD(mySalary.netSalary)}</td>
                                <td><span class="badge badge-${mySalary.status === 'Processed' ? 'success' : 'warning'}">${mySalary.status}</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn btn-small btn-secondary" onclick="viewSalaryDetails(${mySalary.employeeId})">Details</button>
                                        <button class="btn btn-small btn-warning" onclick="openComplaintModal('${mySalary.employeeId}')">Appeal</button>
                                    </div>
                                </td>
                            </tr>
                        ` : '<tr><td colspan="8" style="text-align:center;">No salary record found for your account.</td></tr>'}
                    </tbody>
                </table>
            </div>
        </div>
    `;

    const employeeManagementSection = `
        <!-- Section: Employee Management (HR Only) -->
        ${isManager ? `
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <h2 class="card-title">Management List</h2>
                <div class="card-actions">
                    <button class="btn btn-success" onclick="exportPayroll()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Export Excel
                    </button>
                </div>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Base Salary</th>
                            <th>Total Income</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${manageSalaries.length > 0 ? manageSalaries.map(salary => {
        const emp = appData.employees.find(e => e.id === salary.employeeId);
        const dept = emp ? emp.department : 'N/A';
        return `
                            <tr>
                                <td>${salary.employeeName}</td>
                                <td>${dept}</td>
                                <td>${formatUSD(salary.baseSalary)}</td>
                                <td>
                                    ${formatUSD(salary.baseSalary + salary.bonus + salary.benefits)}
                                    ${(salary.status === 'Pending' || !salary.status) ? '<br><small style="color: #64748b; font-size: 0.75rem;">(Full Estimated)</small>' : ''}
                                </td>
                                <td><span class="badge badge-${salary.status === 'Processed' ? 'success' : (salary.status === 'Pending Approval' || salary.status === 'Waiting') ? 'info' : 'warning'}">${salary.status || 'Pending'}</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn btn-small btn-secondary" onclick="viewSalaryDetails(${salary.employeeId})">Manage</button>
                                        ${(salary.status === 'Pending' || !salary.status || salary.status === 'Pending Approval') ? `
                                            <button class="btn btn-small btn-success" onclick="processSalary(${salary.employeeId})">
                                                ${roles.includes('admin') ? 'Approve' : 'Submit'}
                                            </button>
                                        ` : '<span class="text-gray-500 text-sm">Processed</span>'}
                                    </div>
                                </td>
                            </tr>
                            `;
    }).join('') : '<tr><td colspan="6" style="text-align:center;">No other employees to manage.</td></tr>'}
                    </tbody>
                </table>
            </div>
        </div>
        ` : ''}
    `;

    const requestsSection = `
        <!-- Section: Salary Change Requests -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Salary Change Requests</h2>
                <div class="card-actions">
                    <button class="btn btn-primary" onclick="openSalaryProposalModal()">Propose Salary Change</button>
                </div>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Current</th>
                            <th>Proposed</th>
                            <th>Requester</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${appData.salaryRequests.length > 0 ? appData.salaryRequests.map(req => `
                            <tr>
                                <td>${req.employee_name}</td>
                                <td>${formatUSD(req.current_salary)}</td>
                                <td style="color: var(--primary-color); font-weight: 600;">${formatUSD(req.proposed_salary)}</td>
                                <td>${req.requester_name.split('@')[0]}</td>
                                <td><span class="badge badge-${req.status === 'Approved' ? 'success' : req.status === 'Rejected' ? 'danger' : 'info'}">${req.status}</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn btn-small btn-secondary" onclick="viewSalaryRequestDetails(${req.id})">Details</button>
                                        ${req.status === 'Pending' ? `
                                            <button class="btn btn-small btn-success" onclick="handleSalaryRequestAction(${req.id}, 'approve')">Approve</button>
                                            <button class="btn btn-small btn-danger" onclick="handleSalaryRequestAction(${req.id}, 'reject')">Reject</button>
                                        ` : ''}
                                    </div>
                                </td>
                            </tr>
                        `).join('') : '<tr><td colspan="6" style="text-align:center;">No salary requests found.</td></tr>'}
                    </tbody>
                </table>
            </div>
        </div>
    `;

    // Only show requestsSection on "Employee Salary" (team) for managers, 
    // OR on "My Salary" for non-managers (so they don't see it twice, but still see it once).
    const showRequests = (viewType === 'team') || (viewType === 'my' && !isManager);

    return `
        <div class="page-header">
            <h1>${headerTitle}</h1>
            ${headerDesc ? `<p>${headerDesc}</p>` : ''}
        </div>

        ${viewType === 'my' ? mySalarySection : employeeManagementSection}
        ${showRequests ? requestsSection : ''}
    `;
}

async function openSalaryProposalModal() {
    const employees = appData.employees;

    // Determine who we can propose for
    // Regular employees usually propose for themselves.
    // Managers can propose for others.
    const currentUserEmail = appData.currentUser?.email || "";
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const isManager = roles.includes('hr') || roles.includes('admin');

    const modal = `
        <div class="modal-overlay" onclick="closeModal(event)">
            <div class="modal" onclick="event.stopPropagation()">
                <div class="modal-header">
                    <h2 class="modal-title">Propose Salary Change</h2>
                    <button class="modal-close" onclick="closeModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <form id="salary-proposal-form" onsubmit="handleSalaryProposalSubmit(event)">
                        <div class="form-group">
                            <label class="form-label">Employee</label>
                            <select class="form-select" name="employee_id" required onchange="updateProposedSalaryCurrent(this)">
                                <option value="">Select Employee</option>
                                ${employees.map(e => `
                                    <option value="${e.id}" ${e.email === currentUserEmail ? 'selected' : ''} data-salary="${e.salary}">
                                        ${e.name} (${e.position})
                                    </option>
                                `).join('')}
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Current Salary (USD)</label>
                                <input type="number" id="current-salary-display" class="form-input" readonly style="background-color: #f1f5f9;">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Proposed Salary (USD)</label>
                                <input type="number" class="form-input" name="proposed_salary" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Reason for Change</label>
                            <textarea class="form-input" name="reason" rows="3" placeholder="Explain why this change is needed..." required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="document.getElementById('salary-proposal-form').requestSubmit()">Submit Proposal</button>
                </div>
            </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modal;

    // Set initial current salary if an employee is selected
    const select = document.querySelector('select[name="employee_id"]');
    if (select && select.value) updateProposedSalaryCurrent(select);
}

window.updateProposedSalaryCurrent = function (select) {
    const selectedOption = select.options[select.selectedIndex];
    const currentSalary = selectedOption.getAttribute('data-salary');
    const display = document.getElementById('current-salary-display');
    if (display) display.value = currentSalary || 0;
}

async function handleSalaryProposalSubmit(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const data = {
        employee_id: parseInt(formData.get('employee_id')),
        proposed_salary: parseFloat(formData.get('proposed_salary')),
        reason: formData.get('reason')
    };

    const token = localStorage.getItem('token');
    try {
        const res = await fetch(`${API_BASE_URL}/api/v1/payroll/salary-requests`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            showToast("Salary proposal submitted successfully.");
            closeModal();
            await fetchSalaryRequests();
            if (currentPage === 'salary') renderPage('salary');
        } else {
            const err = await res.json();
            showToast(err.detail || "Failed to submit proposal.", "danger");
        }
    } catch (e) {
        showToast("Error connecting to server.", "danger");
    }
}

async function handleSalaryRequestAction(id, action) {
    const token = localStorage.getItem('token');
    try {
        const res = await fetch(`${API_BASE_URL}/api/v1/payroll/salary-requests/${id}/action`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ action: action })
        });

        if (res.ok) {
            showToast(`Salary request ${action}ed.`);
            // RE-FETCH ALL DATA to ensure salaries are updated in appData.employees
            await fetchDashboardData();
            if (currentPage === 'salary') renderPage('salary');
        } else {
            const err = await res.json();
            showToast(err.detail || `Failed to ${action} request.`, "danger");
        }
    } catch (e) {
        showToast("Error connecting to server.", "danger");
    }
}

function viewSalaryRequestDetails(id) {
    const req = appData.salaryRequests.find(r => r.id === id);
    if (!req) return;

    const modal = `
        <div class="modal-overlay" onclick="closeModal(event)">
            <div class="modal" onclick="event.stopPropagation()">
                <div class="modal-header">
                    <h2 class="modal-title">Salary Request Details</h2>
                    <button class="modal-close" onclick="closeModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div style="display: grid; gap: 1rem;">
                        <div class="detail-item">
                            <span class="detail-label">Employee</span>
                            <span class="detail-value">${req.employee_name}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Requester</span>
                            <span class="detail-value">${req.requester_name}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Amount Change</span>
                            <span class="detail-value">
                                ${formatUSD(req.current_salary)} &rarr; 
                                <strong style="color: var(--primary-color)">${formatUSD(req.proposed_salary)}</strong>
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Reason</span>
                            <div style="padding: 1rem; background: #f8fafc; border-radius: 8px; font-size: 0.9rem;">
                                ${req.reason}
                            </div>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Status</span>
                            <span class="badge badge-${req.status === 'Approved' ? 'success' : req.status === 'Rejected' ? 'danger' : 'info'}">
                                ${req.status}
                            </span>
                        </div>
                        ${req.approver_name ? `
                        <div class="detail-item">
                            <span class="detail-label">Approver</span>
                            <span class="detail-value">${req.approver_name}</span>
                        </div>
                        ` : ''}
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Close</button>
                    ${req.status === 'Pending' ? `
                        <button class="btn btn-success" onclick="handleSalaryRequestAction(${req.id}, 'approve')">Approve</button>
                    ` : ''}
                </div>
            </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modal;
}

async function fetchSalaryRequests() {
    const token = localStorage.getItem('token');
    if (!token) return;
    try {
        const res = await fetch(`${API_BASE_URL}/api/v1/payroll/salary-requests`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
            appData.salaryRequests = await res.json();
        }
    } catch (e) {
        console.error("Error fetching salary requests", e);
    }
}

function setupSalaryListeners() {
}


async function viewSalaryDetails(employeeId) {
    const salary = appData.salaries.find(s => s.employeeId === employeeId);
    if (!salary) return;

    const emp = appData.employees.find(e => e.id === employeeId);
    const agreedBase = emp ? (emp.salary || 0) : (salary.baseSalary || 0);

    let workingDays = 0;
    let attendanceDays = 0;
    let lateCount = 0;
    let otHours = 0;
    let otPay = 0;
    let unexcusedAbsentCount = 0;
    let approvedLeaveDays = 0;

    const token = localStorage.getItem('token');
    const monthStr = salary.month || new Date().toISOString().slice(0, 7);
    const [year, month] = monthStr.split('-');
    const dateFrom = `${year}-${month}-01`;
    const lastDay = new Date(year, month, 0).getDate();
    const dateTo = `${year}-${month}-${lastDay}`;

    try {
        const attRes = await fetch(`${API_BASE_URL}/api/v1/attendance?employee_id=${employeeId}&date_from=${dateFrom}&date_to=${dateTo}`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (attRes.ok) {
            const attData = await attRes.json();
            const items = attData.items || [];
            items.forEach(item => {
                if (item.status === 'Present' || item.status === 'Late' || item.status === 'Early Leave' || item.status === 'Late / Early Leave') {
                    attendanceDays++;
                    if (item.status === 'Late') {
                        lateCount += 1;
                    } else if (item.status === 'Early Leave') {
                        lateCount += 1;
                    } else if (item.status === 'Late / Early Leave') {
                        lateCount += 2;
                    } else if (item.status === 'Absent') {
                        unexcusedAbsentCount++;
                    }

                    // --- OT CALCULATION ---
                    // Rule: Checkout > 17:30 counts as OT.
                    if (item.check_out_time) {
                        try {
                            // Format typically "HH:MM:SS"
                            const [h, m] = item.check_out_time.split(':').map(Number);
                            const checkoutMinutes = h * 60 + m;
                            const standardEnd = 17 * 60 + 30; // 17:30 = 1050 mins

                            if (checkoutMinutes > standardEnd) {
                                const diffMinutes = checkoutMinutes - standardEnd;
                                otHours += (diffMinutes / 60);
                            }
                        } catch (err) { console.warn("Time parse error", err); }
                    }
                }
            });
            workingDays = items.length; // Approximate
        }

        const leaveRes = await fetch(`${API_BASE_URL}/api/v1/leaves`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (leaveRes.ok) {
            const allLeaves = await leaveRes.json();
            // Simple matching logic
            const myApprovedLeaves = allLeaves.filter(l =>
                l.employee_id === employeeId &&
                l.approval_status === 'Approved'
            );
            approvedLeaveDays = myApprovedLeaves.reduce((sum, l) => sum + (l.days || 0), 0);
        }

    } catch (e) {
        console.error("Error fetching details", e);
    }

    // --- Permissions ---
    // Strict Check: Only HR Director or HR Staff can edit Bonus. Admin CANNOT.
    const userRole = (appData.currentUser && appData.currentUser.profile) ? appData.currentUser.profile.position_name : "";
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";

    const isHRDirector = userEmail.startsWith("ha1972816");
    const isHRStaff = userRole === "HR Staff";
    // Explicitly excluding Admin or any other role
    const canEditBonus = isHRDirector || isHRStaff;

    const proportionateBase = (emp.salary / 22) * attendanceDays; // Example: 22 working days avg, or 26
    const penaltyTardiness = lateCount * 10; // $10 per late
    const penaltyAbsence = unexcusedAbsentCount * 50; // $50 per absent

    const OT_RATE = 2.0;
    const otPayInitial = otHours * OT_RATE;

    // --- Dynamic Function attached to Helper ---
    window.calculateDynamicSalary = function () {
        const bonusInput = document.getElementById('salary-bonus');
        const bonusVal = parseFloat(bonusInput ? bonusInput.value : 0) || 0;
        const otVal = parseFloat(document.getElementById('salary-ot-hidden').value) || 0;

        // Base + Allowance(80) + OT + Bonus - Penalties
        const totalGross = proportionateBase + 80 + otVal + bonusVal - penaltyTardiness - penaltyAbsence;
        document.getElementById('salary-gross-total').innerText = formatCurrency(totalGross);
    };

    const modalContent = `
        <div class="modal-overlay" onclick="closeModal(event)">
            <div class="modal" onclick="event.stopPropagation()" style="width: 700px; max-width: 90vw;">
                <div class="modal-body" style="padding: 0;">
                    
                    <!-- Header -->
                    <div style="padding: 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                        <h2 style="margin: 0; font-size: 1.25rem; color: #1e293b;">Salary Details</h2>
                        <button onclick="closeModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
                    </div>

                    <div style="padding: 20px;">
                        
                        <!-- Top Info -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 30px;">
                            <div>
                                <div style="font-size: 0.875rem; color: #64748b; margin-bottom: 4px;">Employee</div>
                                <div style="font-weight: 500; color: #0f172a;">${emp ? emp.full_name : 'N/A'}</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 0.875rem; color: #64748b; margin-bottom: 4px;">Status</div>
                                <span class="badge badge-pending">PENDING</span>
                            </div>
                        </div>

                        <!-- Calculation Body -->
                        <div style="display: flex; flex-direction: column; gap: 0;">
                            
                            <!-- Base -->
                            <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px dashed #e2e8f0;">
                                <span style="color: #475569;">Working Days (Total ${attendanceDays + approvedLeaveDays}/${workingDays})</span>
                                <span style="font-family: monospace; color: #475569;">Att: ${attendanceDays} + Leave: ${approvedLeaveDays}</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px dashed #e2e8f0;">
                                <span style="color: #475569;">Base Salary (Proportionate)</span>
                                <input class="form-input" style="width: 100px; text-align: right; padding: 4px;" value="${proportionateBase.toFixed(2)}" disabled>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #e2e8f0;">
                                <span style="color: #475569;">Allowances (Fixed USD)</span>
                                <input class="form-input" style="width: 100px; text-align: right; padding: 4px;" value="80" >
                            </div>

                            <!-- Addons Section -->
                            <div style="background: #f0f9ff; margin: 10px -20px; padding: 15px 20px; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                                <h4 style="margin: 0 0 10px 0; font-size: 0.95rem; color: #0f172a;">Add-ons (OT & Bonuses)</h4>
                                
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <span style="color: #475569;">OT Pay ($2/hr x ${otHours.toFixed(2)}h) - Based on Check-out > 17:30</span>
                                    <span style="font-weight: 600; color: #0f172a;">${formatCurrency(otPayInitial)}</span>
                                    <input type="hidden" id="salary-ot-hidden" value="${otPayInitial}">
                                </div>

                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: #475569;">Contribution Bonus (${canEditBonus ? 'Editable' : 'Locked'})</span>
                                    <input type="number" id="salary-bonus" class="form-input" 
                                           style="width: 120px; text-align: right; ${!canEditBonus ? 'background: #f1f5f9; cursor: not-allowed; color: #94a3b8;' : ''}" 
                                           value="0" min="0" step="10" 
                                           oninput="calculateDynamicSalary()" 
                                           ${!canEditBonus ? 'disabled' : ''}>
                                </div>
                            </div>

                            <!-- Penalties Section -->
                            <div style="background: #fef2f2; margin: 0 -20px 20px -20px; padding: 15px 20px; border-bottom: 1px solid #e2e8f0;">
                                <h4 style="margin: 0 0 10px 0; font-size: 0.95rem; color: #991b1b;">Disciplinary Penalties</h4>
                                
                                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                    <span style="color: #475569;">Tardiness (${lateCount} times)</span>
                                    <span style="color: #dc2626; font-weight: 500;">- ${formatCurrency(penaltyTardiness)}</span>
                                </div>

                                <div style="display: flex; justify-content: space-between;">
                                    <span style="color: #475569;">Unexcused Absence (${unexcusedAbsentCount} times)</span>
                                    <span style="color: #dc2626; font-weight: 500;">- ${formatCurrency(penaltyAbsence)}</span>
                                </div>
                            </div>

                            <!-- Final Total -->
                            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 10px;">
                                <span style="font-weight: 600; font-size: 1.1rem; color: #0f172a;">Final Gross Income</span>
                                <h3 id="salary-gross-total" style="margin: 0; color: #2563eb;">${formatCurrency(proportionateBase + 80 + otPayInitial - penaltyTardiness - penaltyAbsence)}</h3>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modalContent;
}

// CSS for Password Modal
const passwordModalStyles = `
    <style>
    .password-field-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .password-field-wrapper input {
        padding-right: 40px; /* Space for eye icon */
    }
    .toggle-password-btn {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .validation-list {
        list-style: none;
        padding: 0;
        margin: 10px 0 0 0;
        font-size: 0.85rem;
    }
    .validation-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        color: #ef4444; /* Default Red */
        transition: color 0.3s ease;
    }
    .validation-item.valid {
        color: #22c55e; /* Green */
    }
    .validation-icon {
        width: 14px;
        height: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
    .validation-item.valid .validation-icon::before {
        content: '✓';
    }
    .validation-item:not(.valid) .validation-icon::before {
        content: '✕';
    }
    </style>
`;

function openChangePasswordModal() {
    // Inject styles if not present
    if (!document.getElementById('password-modal-styles')) {
        document.head.insertAdjacentHTML('beforeend', passwordModalStyles);
    }

    const modal = `
    <div class="modal-overlay" onclick="closeModal(event)" style="z-index: 10001;">
        <div class="modal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h2 class="modal-title">Change Password</h2>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="change-password-form" onsubmit="handleChangePassword(event)">
                    <!-- Old Password -->
                    <div class="form-group">
                        <label class="form-label">Old Password</label>
                        <div class="password-field-wrapper">
                            <input type="password" class="form-input" name="old_password" id="old_password" required placeholder="Enter current password">
                                <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('old_password')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                        </div>
                    </div>

                    <!-- New Password -->
                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <div class="password-field-wrapper">
                            <input type="password" class="form-input" name="new_password" id="new_password" required oninput="validatePasswordLive()">
                                <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('new_password')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                        </div>
                        <!-- Validation Requirements -->
                        <ul class="validation-list">
                            <li id="rule-length" class="validation-item"><span class="validation-icon"></span> At least 8 characters</li>
                            <li id="rule-upper" class="validation-item"><span class="validation-icon"></span> Uppercase Letter (A-Z)</li>
                            <li id="rule-lower" class="validation-item"><span class="validation-icon"></span> Lowercase Letter (a-z)</li>
                            <li id="rule-number" class="validation-item"><span class="validation-icon"></span> Number (0-9)</li>
                            <li id="rule-special" class="validation-item"><span class="validation-icon"></span> Special Character (!@#...)</li>
                        </ul>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label class="form-label">Confirm New Password</label>
                        <div class="password-field-wrapper">
                            <input type="password" class="form-input" name="confirm_password" id="confirm_password" required oninput="checkConfirmMatch()">
                                <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('confirm_password')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                        </div>
                        <small id="confirm-msg" style="display:none; color: #ef4444; margin-top: 4px;">Passwords do not match</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button class="btn btn-primary" id="save-pass-btn" disabled onclick="document.getElementById('change-password-form').requestSubmit()">Update Password</button>
            </div>
        </div>
        </div>
    `;
    document.getElementById('modal-container').innerHTML = modal;
}

function togglePasswordVisibility(fieldId) {
    const input = document.getElementById(fieldId);
    if (input) {
        input.type = input.type === 'password' ? 'text' : 'password';
    }
}

function validatePasswordLive() {
    const pw = document.getElementById('new_password').value;
    const saveBtn = document.getElementById('save-pass-btn');

    const rules = {
        length: pw.length >= 8,
        upper: /[A-Z]/.test(pw),
        lower: /[a-z]/.test(pw),
        number: /\d/.test(pw),
        special: /[!@#$%^&*(),.?":{}|<>]/.test(pw)
    };

    let allValid = true;
    for (const [key, isValid] of Object.entries(rules)) {
        const el = document.getElementById(`rule-${key}`);
        if (el) {
            if (isValid) {
                el.classList.add('valid');
            } else {
                el.classList.remove('valid');
                allValid = false;
            }
        }
    }

    checkConfirmMatch(allValid);
}

function checkConfirmMatch(isStrong = null) {
    const pw = document.getElementById('new_password').value;
    const confirmPw = document.getElementById('confirm_password').value;
    const msg = document.getElementById('confirm-msg');
    const saveBtn = document.getElementById('save-pass-btn');

    // If isStrong not passed, re-evaluate it
    if (isStrong === null) {
        // Just verify strength implicitly or just check match here
        // But the main driver for button enable is BOTH strength AND match
        // Let's re-run validation logic slightly redundantly but safely
        const rules = {
            length: pw.length >= 8,
            upper: /[A-Z]/.test(pw),
            lower: /[a-z]/.test(pw),
            number: /\d/.test(pw),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(pw)
        };
        isStrong = Object.values(rules).every(Boolean);
    }

    const match = pw === confirmPw && pw !== "";

    if (confirmPw && !match) {
        msg.style.display = 'block';
        msg.innerText = "Passwords do not match";
        msg.style.color = '#ef4444';
    } else if (match) {
        msg.style.display = 'block';
        msg.innerText = "Match ✓";
        msg.style.color = '#22c55e';
    } else {
        msg.style.display = 'none';
    }

    if (isStrong && match) {
        saveBtn.removeAttribute('disabled');
    } else {
        saveBtn.setAttribute('disabled', 'true');
    }
}

async function handleChangePassword(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const oldPass = formData.get('old_password');
    const newPass = formData.get('new_password');
    const confirmPass = formData.get('confirm_password');

    if (newPass !== confirmPass) {
        showToast("Passwords do not match", "danger");
        return;
    }

    const token = localStorage.getItem('token');
    try {
        // Corrected API Endpoint based on backend/auth.py
        const res = await fetch(`${API_BASE_URL}/api/v1/auth/change-password`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ old_password: oldPass, new_password: newPass })
        });

        if (res.ok) {
            showToast("Password updated successfully");
            closeModal();
        } else {
            const err = await res.json();
            showToast("Error: " + (err.detail || "Failed to update"), "danger");
        }
    } catch (e) {
        console.error(e);
        showToast("Network Error", "danger");
    }
}

function recalcSalaryTotal() {
    const form = document.getElementById('process-salary-form');
    if (!form) return;

    const baseSalary = parseFloat(form.getElementsByTagName('input')[0].value) || 0;
    const allowance = parseFloat(form.getElementsByTagName('input')[1].value) || 0;
    const otPay = parseFloat(document.getElementById('ot-pay-input').value) || 0;
    const contribution = parseFloat(document.getElementById('contribution-input').value) || 0;
    const penaltyTotal = parseFloat(document.getElementById('penalty-total-input').value) || 0;

    const totalIncome = baseSalary + allowance + otPay + contribution - penaltyTotal;

    document.getElementById('total-income-display').innerText = formatUSD(totalIncome);
    document.getElementById('tax-display').innerText = '-' + formatUSD(totalIncome * 0.10);
    document.getElementById('net-salary-display').innerText = formatUSD(totalIncome * 0.90);
}
window.recalcSalaryTotal = recalcSalaryTotal;

async function handleProcessSalary(event, employeeId) {
    event.preventDefault();
    const salary = appData.salaries.find(s => s.employeeId === employeeId);
    if (!salary) return;

    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const isAdmin = roles.includes('admin');
    const isDirector = roles.includes('director');

    const isApprover = isDirector || isAdmin;
    const actionVerb = isApprover ? 'approve/process' : 'submit';

    if (!confirm(`Are you sure you want to ${actionVerb} this payroll ? `)) return;

    const form = event.target;
    const baseVal = parseFloat(form.getElementsByTagName('input')[0].value) || 0;
    const allowanceVal = parseFloat(form.getElementsByTagName('input')[1].value) || 0;
    const otPay = parseFloat(document.getElementById('ot-pay-input').value) || 0;
    const contribution = parseFloat(document.getElementById('contribution-input').value) || 0;
    const penaltyVal = parseFloat(document.getElementById('penalty-total-input').value) || 0;

    const totalBonus = otPay + contribution;
    const token = localStorage.getItem('token');

    try {
        const response = await fetch(`${API_BASE_URL}/api/v1/payroll`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                employee_id: employeeId,
                month: salary.month || new Date().toISOString().slice(0, 7),
                base_salary: baseVal,
                bonus: totalBonus,
                benefits: allowanceVal,
                deductions: penaltyVal,
                status: isApprover ? 'Processed' : 'Pending Approval'
            })
        });

        if (response.ok) {
            showToast("Success");
            await fetchDashboardData();
            renderPage('salary');
            closeModal();
        } else {
            const err = await response.json();
            showToast("Error: " + (err.detail || "Unknown error"), "danger");
        }
    } catch (e) {
        console.error(e);
        showToast("Error", "danger");
    }
}

function processSalary(id) {
    viewSalaryDetails(id);
}



// Announcements
function renderAnnouncements() {
    const roles = JSON.parse(localStorage.getItem('roles') || '[]');
    const userEmail = (appData.currentUser && appData.currentUser.email) ? appData.currentUser.email : "";
    const isHrDirector = userEmail.startsWith("ha1972816");
    const isAdmin = roles.includes('admin') || userEmail.startsWith("to1979714");

    // Manager = Admin or HR (Director/Staff)
    const isManager = isAdmin || isHrDirector || roles.includes('hr');

    const hiddenAnns = JSON.parse(localStorage.getItem('hiddenAnnouncements') || '[]');
    const visibleAnns = appData.announcements.filter(ann => !hiddenAnns.includes(ann.id));

    return `
    <div class="page-header">
        <h1>Announcements</h1>
    </div>

    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="card-title">Latest News</h2>
            ${isManager ? `
                <button class="btn btn-primary" onclick="openAddAnnouncementModal()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Post Announcement
                </button>
                ` : ''}
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Content</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    ${visibleAnns.length > 0 ? visibleAnns.map(ann => `
                            <tr>
                                <td style="width: 150px;">${new Date(ann.created_at || Date.now()).toLocaleDateString()}</td>
                                <td style="font-weight: bold;">${ann.title}</td>
                                <td>${ann.content}</td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn btn-small btn-secondary" onclick="handleDeleteNotification(${ann.id}, 'announcement', event)" title="Hide for me">Clear</button>
                                        ${(isAdmin || isHrDirector) ? `
                                            <button class="btn btn-small btn-danger" onclick="deleteAnnouncement(${ann.id})" title="Delete for Everyone">Global Delete</button>
                                        ` : ''}
                                    </div>
                                </td>
                            </tr>
                        `).join('') : `<tr><td colspan="4" style="text-align: center; padding: 20px;">No announcements yet</td></tr>`}
                </tbody>
            </table>
        </div>
    </div>
`;
}

